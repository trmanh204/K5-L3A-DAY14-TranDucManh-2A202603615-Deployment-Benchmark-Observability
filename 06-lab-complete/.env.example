# Sao chép file này thành .env khi chạy local (KHÔNG commit .env lên Git)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — điền key riêng khi chạy local hoặc đặt trên dashboard cloud
AGENT_API_KEY=

# Redis — dùng cho Rate Limiting & Cost Guard (stateless)
REDIS_URL=redis://localhost:6379/0

# Guardrails
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
